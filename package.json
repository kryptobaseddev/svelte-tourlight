{
	"name": "svelte-tourlight",
	"version": "0.1.3",
	"description": "Svelte 5 product tours: spotlight cutouts, multi-page steps that survive reloads, click-the-real-button steps, pulsing beacons, keyboard and screen-reader support, and tours as JSON. A port inspired by react-tourlight.",
	"license": "MIT",
	"author": "kryptobaseddev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kryptobaseddev/svelte-tourlight.git"
	},
	"homepage": "https://kryptobaseddev.github.io/svelte-tourlight/",
	"bugs": {
		"url": "https://github.com/kryptobaseddev/svelte-tourlight/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"tour",
		"product-tour",
		"onboarding",
		"spotlight",
		"walkthrough",
		"coachmark",
		"beacon",
		"a11y"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "svelte-kit sync && vite dev",
		"build": "svelte-kit sync && vite build && pnpm run package",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "svelte-kit sync && vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"package": "svelte-kit sync && svelte-package && publint"
	},
	"files": [
		"dist",
		"schema",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"NOTICE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./document": {
			"types": "./dist/document/index.d.ts",
			"default": "./dist/document/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./schema.json": "./schema/tour.schema.json",
		"./package.json": "./package.json"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@floating-ui/dom": "1.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"packageManager": "pnpm@12.6.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
